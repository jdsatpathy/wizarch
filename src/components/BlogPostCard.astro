---
interface Props {
  title: string;
  description: string;
  pubDate: string;
  category: string;
  tags: string[];
  readTime: string;
  slug: string;
}

const { title, description, pubDate, category, tags, readTime, slug } = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<a
  href={`/posts/${slug}`}
  class="blog-post-card"
  data-tags={tags.map(t => t.toLowerCase()).join(',')}
>
  <div class="blog-post-card__header">
    <span class="blog-post-card__meta">{category}</span>
    <span class="blog-post-card__date">{formattedDate} · {readTime}</span>
  </div>

  <h2>{title}</h2>
  <p>{description}</p>

  <div class="blog-post-card__footer">
    <div class="blog-post-card__tags">
      {tags.map((tag) => (
        <span class="blog-post-card__tag">#{tag}</span>
      ))}
    </div>
    <span class="blog-post-card__readmore">Read article →</span>
  </div>
</a>
